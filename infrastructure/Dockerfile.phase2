# Preparation only. Not built/deployed or claimed reproducible beyond the locked ASR wheels.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core libportaudio2 \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements-asr.lock /app/
RUN python -m venv /app/.venv && /app/.venv/bin/pip install --require-hashes -r requirements-asr.lock
COPY . /app
USER 10001:10001
CMD ["/app/.venv/bin/python", "-m", "beyond_orbit.pipeline", "--help"]
