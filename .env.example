# Never paste real keys into this file or commit them.
# Create separate development projects and store real values in an ignored .env
# file or a managed secret store.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional engines/connectors. OAuth is preferred when the vendor supports it.
PEAKCUT_AI_PROVIDER=gemini
PEAKCUT_AI_MODELS=
PEAKCUT_AI_KEY=

# Live publishing is deliberately disabled in tonight's build.
BEYOND_ORBIT_LIVE_PUBLISHING=0
BEYOND_ORBIT_REQUIRE_CREATIVE_APPROVAL=1
BEYOND_ORBIT_REQUIRE_PUBLISH_APPROVAL=1
